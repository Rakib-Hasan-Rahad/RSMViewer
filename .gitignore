# ── External runtimes and datasets ───────────────────────────────────────────
# The repository ships the external/ folder structure, its README files, and a
# small RMSX preannotated sample (1s72, 1ffk). Every other PDB is downloaded
# per PDB into rmsx_work_default/ on first use and is NOT versioned (see
# external/rmsx_preannotated/README.md). The old offline bundle is no longer used
# but stays ignored so a copy left on disk is never committed by accident.
external/rmsx_preannotated/rmsx_preannotated_input_output.tar.gz
external/rmsx_preannotated/rmsx_work_default/
!external/rmsx_preannotated/rmsx_work_default/1s72/
!external/rmsx_preannotated/rmsx_work_default/1s72/**
!external/rmsx_preannotated/rmsx_work_default/1ffk/
!external/rmsx_preannotated/rmsx_work_default/1ffk/**
external/rmsx/**/RNAVIEW/
# Scanner built from source by `rmv_setup RNAMotifScanX` (one folder per platform)
external/rmsx/bin/*/
external/fr3d/fr3d-python-latest/*
!external/fr3d/fr3d-python-latest/.gitkeep

# ── Python build artifacts ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.sqlite3
# macOS metadata
.DS_Store

# Local instructions; keep out of GitHub
GITHUB_UPLOAD_INSTRUCTIONS.txt

# Local-only audit reports; keep out of GitHub
RMSX_AUDIT_REPORT.md

# ── Local dev/test harness, not shipped with the plugin ──────────────────────
/tests/

# ── Structures fetched locally during development/testing ───────────────────
/*.cif
/*.cif.gz
/cached_structures/*
!/cached_structures/.gitkeep

# ── RMSX benchmark/test run outputs ──────────────────────────────────────────
/output/rmsx_results/
/output/fr3d_runs/*
!/output/fr3d_runs/1S72/
!/output/fr3d_runs/1S72/**

# ── Local manuscript/benchmark work ─────────────────────────────────────────
# Figure S3 scripts and generated results are kept locally and are not part of
# the distributable plugin repository.
/figure s3/
/external/fr3d_local_from_csv/
/rsmviewer/database/user_annotations/fr3d/
/output/S3_4_*/
